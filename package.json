{
  "name": "novus",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --config infra/wrangler/wrangler.toml --env-file .dev.vars",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json",
    "check": "npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:infra": "vitest run --config infra/vitest.config.ts",
    "test:workers": "vitest run --config infra/vitest.workers.config.ts",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "release:gates": "tsx infra/scripts/release-gates.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply novus-main --local --config infra/wrangler/wrangler.toml",
    "db:seed:local": "node --experimental-strip-types infra/scripts/seed-local.ts",
    "db:migrate:events:local": "wrangler d1 migrations apply novus-events --local --config infra/wrangler/wrangler.toml",
    "registry:import:local": "tsx infra/scripts/import-candidates.ts --local"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^3.10.0",
    "@modelcontextprotocol/hono": "2.0.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
