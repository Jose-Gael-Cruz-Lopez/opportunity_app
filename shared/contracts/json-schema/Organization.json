{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novus/Organization.json",
  "title": "Organization",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "kind": {
      "type": "string",
      "enum": [
        "federal_agency",
        "state_agency",
        "foundation",
        "nonprofit",
        "company",
        "university",
        "national_lab",
        "professional_society",
        "other"
      ]
    },
    "country": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2
    },
    "defaultTimeZone": {
      "anyOf": [
        {
          "type": "string",
          "description": "IANA time zone, e.g. America/Chicago"
        },
        {
          "type": "null"
        }
      ]
    },
    "websiteUrl": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "isSample": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "id",
    "slug",
    "name",
    "kind",
    "country",
    "defaultTimeZone",
    "websiteUrl"
  ],
  "additionalProperties": false
}
