{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novus/CursorQuery.json",
  "title": "CursorQuery",
  "type": "object",
  "properties": {
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 25
    }
  },
  "additionalProperties": false
}
