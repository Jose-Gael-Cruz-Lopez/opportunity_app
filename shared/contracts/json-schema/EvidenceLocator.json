{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novus/EvidenceLocator.json",
  "title": "EvidenceLocator",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "html"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "selector": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "kind",
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "pdf_text"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "page",
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "upload_text"
        },
        "documentId": {
          "type": "string",
          "format": "uuid"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "documentId",
        "page",
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "ocr_image"
        },
        "documentId": {
          "type": "string",
          "format": "uuid"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "kind",
        "documentId",
        "page",
        "bbox"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "qr"
        },
        "documentId": {
          "type": "string",
          "format": "uuid"
        },
        "payloadUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      },
      "required": [
        "kind",
        "documentId",
        "payloadUrl"
      ],
      "additionalProperties": false
    }
  ]
}
