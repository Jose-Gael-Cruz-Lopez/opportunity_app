{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novus/CurationPatch.json",
  "title": "CurationPatch",
  "type": "object",
  "properties": {
    "rowHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "organization": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "enum": [
            "federal_agency",
            "state_agency",
            "foundation",
            "nonprofit",
            "company",
            "university",
            "national_lab",
            "professional_society",
            "other"
          ]
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2,
          "default": "US"
        },
        "defaultTimeZone": {
          "anyOf": [
            {
              "type": "string",
              "description": "IANA time zone, e.g. America/Chicago"
            },
            {
              "type": "null"
            }
          ]
        },
        "websiteUrl": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "slug",
        "name",
        "kind",
        "defaultTimeZone",
        "websiteUrl"
      ],
      "additionalProperties": false
    },
    "program": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
