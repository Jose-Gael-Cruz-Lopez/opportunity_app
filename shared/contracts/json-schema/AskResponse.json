{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novus/AskResponse.json",
  "title": "AskResponse",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "gemini",
            "none"
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "promptVersion": {
          "type": "string",
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "unavailable"
          ]
        },
        "degradedReason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "no_api_key",
                "disabled",
                "provider_error",
                "timeout",
                "rate_limited",
                "budget_exceeded",
                "validation_failed",
                "citation_check_failed",
                "safety_blocked"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "fallback": {
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "model",
        "promptVersion",
        "status",
        "degradedReason",
        "generatedAt",
        "fallback"
      ],
      "additionalProperties": false
    },
    "answer": {
      "type": "string",
      "maxLength": 2000
    },
    "answerType": {
      "type": "string",
      "enum": [
        "answered",
        "partial",
        "not_in_sources",
        "declined_sensitive"
      ]
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^s\\d{1,3}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "program_page",
              "novus_record",
              "readiness_report",
              "methodology",
              "student_text"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ]
          },
          "quote": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "sourceId",
          "kind",
          "title",
          "url",
          "quote"
        ],
        "additionalProperties": false
      },
      "maxItems": 10
    },
    "programRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "slug",
          "name"
        ],
        "additionalProperties": false
      },
      "maxItems": 10
    },
    "followUps": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "maxItems": 4
    }
  },
  "required": [
    "meta",
    "answer",
    "answerType",
    "citations",
    "programRefs",
    "followUps"
  ],
  "additionalProperties": false
}
