{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novus/ProgramCycle.json",
  "title": "ProgramCycle",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "programId": {
      "type": "string",
      "format": "uuid"
    },
    "cycleKey": {
      "type": "string",
      "pattern": "^(?:(spring|summer|fall|winter|year|rolling)-(\\d{4})|ay-(\\d{4})-(\\d{2}))$"
    },
    "termLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "cycleModel": {
      "type": "string",
      "enum": [
        "term",
        "rolling",
        "event",
        "round_based"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "expected",
        "open",
        "closed",
        "paused",
        "ended",
        "relaunched"
      ]
    },
    "statusChangedAt": {
      "type": "string",
      "format": "date-time"
    },
    "statusChangedBy": {
      "type": "string",
      "maxLength": 80
    },
    "timeZone": {
      "anyOf": [
        {
          "type": "string",
          "description": "IANA time zone, e.g. America/Chicago"
        },
        {
          "type": "null"
        }
      ]
    },
    "opensOn": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "predictedOpensOn": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "predictionLabel": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "decisionWindowStart": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "decisionWindowEnd": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "decisionsReleasedOn": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "eventStart": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "eventEnd": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "applicationUrl": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "pellDisplacement": {
      "type": "string",
      "enum": [
        "none",
        "possible",
        "yes",
        "unknown"
      ]
    },
    "applicationFeeCents": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "participantCostCents": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "compensation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "stipend",
                "salary_hourly",
                "award",
                "tuition",
                "travel",
                "none",
                "varies"
              ]
            },
            "amountCents": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "period": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "one_time",
                    "hour",
                    "week",
                    "month",
                    "term",
                    "year",
                    "total"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "note": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "kind",
            "amountCents",
            "period"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "verificationState": {
      "type": "string",
      "enum": [
        "draft",
        "verified",
        "reverifying",
        "unverified"
      ]
    },
    "lastVerifiedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "verifiedBy": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceCheckedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "rolledOverFromId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "id",
    "programId",
    "cycleKey",
    "termLabel",
    "cycleModel",
    "status",
    "statusChangedAt",
    "statusChangedBy",
    "timeZone",
    "opensOn",
    "predictedOpensOn",
    "predictionLabel",
    "decisionWindowStart",
    "decisionWindowEnd",
    "decisionsReleasedOn",
    "eventStart",
    "eventEnd",
    "applicationUrl",
    "pellDisplacement",
    "applicationFeeCents",
    "participantCostCents",
    "compensation",
    "verificationState",
    "lastVerifiedAt",
    "verifiedBy",
    "sourceCheckedAt",
    "rolledOverFromId",
    "version"
  ],
  "additionalProperties": false
}
