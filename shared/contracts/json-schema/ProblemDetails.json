{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novus/ProblemDetails.json",
  "title": "ProblemDetails",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "maxLength": 300
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "code": {
      "type": "string",
      "enum": [
        "bad_request",
        "validation_failed",
        "sensitive_field_rejected",
        "unauthenticated",
        "forbidden",
        "not_found",
        "conflict",
        "consent_required",
        "version_conflict",
        "precondition_failed",
        "payload_too_large",
        "rate_limited",
        "ai_unavailable",
        "unavailable",
        "internal"
      ]
    },
    "detail": {
      "type": "string",
      "maxLength": 500
    },
    "instance": {
      "type": "string",
      "maxLength": 300
    },
    "requestId": {
      "type": "string",
      "maxLength": 100
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 200
          },
          "message": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "path",
          "message"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    }
  },
  "required": [
    "type",
    "title",
    "status",
    "code"
  ],
  "additionalProperties": false
}
