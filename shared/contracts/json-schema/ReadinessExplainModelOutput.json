{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novus/ReadinessExplainModelOutput.json",
  "title": "ReadinessExplainModelOutput",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part": {
            "type": "string",
            "enum": [
              "eligibility",
              "requirements",
              "competitiveness",
              "next_actions"
            ]
          },
          "text": {
            "type": "string"
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "part",
          "text",
          "sourceIds"
        ],
        "additionalProperties": false
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "nextActionId": {
            "type": "string"
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "text",
          "nextActionId",
          "sourceIds"
        ],
        "additionalProperties": false
      }
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "summary",
    "points",
    "suggestions",
    "caveats"
  ],
  "additionalProperties": false
}
