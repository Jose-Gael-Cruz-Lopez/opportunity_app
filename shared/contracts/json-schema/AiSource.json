{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novus/AiSource.json",
  "title": "AiSource",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^s\\d{1,3}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "program_page",
        "novus_record",
        "readiness_report",
        "methodology",
        "student_text"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "programSlug": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "text": {
      "type": "string",
      "maxLength": 8000
    },
    "retrievedOn": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "kind",
    "title",
    "url",
    "programSlug",
    "text",
    "retrievedOn"
  ],
  "additionalProperties": false
}
