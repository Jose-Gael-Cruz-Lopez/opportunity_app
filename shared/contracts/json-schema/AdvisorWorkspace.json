{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novus/AdvisorWorkspace.json",
  "title": "AdvisorWorkspace",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "institutionId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "concierge_pilot",
        "self_service"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "isSample": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "id",
    "name",
    "institutionId",
    "kind",
    "createdAt"
  ],
  "additionalProperties": false
}
