{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novus/Deadline.json",
  "title": "Deadline",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "programCycleId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string",
      "enum": [
        "application",
        "campus_internal",
        "nomination",
        "priority_round",
        "recommendation",
        "supplemental",
        "interest_form",
        "decision_expected",
        "program_start"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "national",
        "campus"
      ]
    },
    "institutionId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "roundLabel": {
      "type": "string",
      "maxLength": 60,
      "default": ""
    },
    "basis": {
      "type": "string",
      "enum": [
        "official",
        "attested",
        "predicted"
      ]
    },
    "precision": {
      "type": "string",
      "enum": [
        "exact",
        "date_only",
        "month_only",
        "window",
        "rolling",
        "tbd"
      ]
    },
    "tzMode": {
      "type": "string",
      "enum": [
        "fixed",
        "applicant_local"
      ]
    },
    "localDate": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "localTime": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)(?::([0-5]\\d))?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "windowStart": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "windowEnd": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "timeZone": {
      "anyOf": [
        {
          "type": "string",
          "description": "IANA time zone, e.g. America/Chicago"
        },
        {
          "type": "null"
        }
      ]
    },
    "tzSource": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "stated",
            "org_default"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "dueAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "sortAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "verificationState": {
      "type": "string",
      "enum": [
        "draft",
        "verified",
        "reverifying",
        "unverified"
      ]
    },
    "withdrawnAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "programCycleId",
    "kind",
    "scope",
    "institutionId",
    "basis",
    "precision",
    "tzMode",
    "localDate",
    "localTime",
    "windowStart",
    "windowEnd",
    "timeZone",
    "tzSource",
    "dueAt",
    "sortAt",
    "revision",
    "verificationState",
    "withdrawnAt"
  ],
  "additionalProperties": false
}
