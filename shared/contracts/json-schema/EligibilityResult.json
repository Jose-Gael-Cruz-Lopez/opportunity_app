{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novus/EligibilityResult.json",
  "title": "EligibilityResult",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "met",
        "not_met",
        "unknown"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "eligible",
        "conditional",
        "unknown",
        "not_eligible"
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}$"
          },
          "dimension": {
            "type": "string",
            "enum": [
              "standing",
              "enrollment",
              "transfer",
              "gpa",
              "citizenship",
              "pell",
              "institution",
              "field",
              "identity",
              "age",
              "residency",
              "first_gen",
              "prior_award",
              "team",
              "host_enrollment"
            ]
          },
          "group": {
            "type": "string",
            "maxLength": 40
          },
          "verdict": {
            "type": "string",
            "enum": [
              "met",
              "not_met",
              "unknown"
            ]
          },
          "sensitive": {
            "type": "boolean"
          },
          "reasonCode": {
            "type": "string",
            "maxLength": 60
          },
          "reason": {
            "type": "string",
            "maxLength": 400
          },
          "officialText": {
            "type": "string",
            "maxLength": 400
          },
          "missingFields": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "classYear",
                "semestersRemaining",
                "yearsRemaining",
                "expectedGraduationTerm",
                "expectedGraduationYear",
                "enrollmentIntensity",
                "institutionLevel",
                "transferIntent",
                "gpaBand",
                "gpaMin",
                "gpaMax",
                "majorCip",
                "minorCip",
                "majorFamily",
                "residenceState",
                "ageAtAsOf",
                "institutionId",
                "institutionParticipates",
                "citizenship",
                "pell",
                "financialNeed",
                "firstGeneration",
                "identity.race_ethnicity",
                "identity.gender_identity",
                "identity.sexual_orientation",
                "identity.health",
                "identity.religion",
                "identity.tribal_affiliation",
                "identity.military_veteran",
                "identity.foster_care",
                "identity.crime_victim",
                "identity.parenting"
              ]
            }
          },
          "resolver": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "student",
                  "novus"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "evidenceKey": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^e\\d{1,3}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "fieldEvidenceId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "basis": {
                    "type": "string",
                    "enum": [
                      "snapshot",
                      "attestation",
                      "api_record",
                      "manual_note"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "quote": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 2000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "retrievedOn": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "basis",
                  "url",
                  "quote",
                  "retrievedOn"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ruleId",
          "dimension",
          "group",
          "verdict",
          "sensitive",
          "reasonCode",
          "reason",
          "officialText",
          "missingFields",
          "resolver",
          "evidenceKey",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "enum": [
              "rule",
              "attestation",
              "coverage",
              "rule_set_missing"
            ]
          },
          "dimension": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "standing",
                  "enrollment",
                  "transfer",
                  "gpa",
                  "citizenship",
                  "pell",
                  "institution",
                  "field",
                  "identity",
                  "age",
                  "residency",
                  "first_gen",
                  "prior_award",
                  "team",
                  "host_enrollment"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "sensitive": {
            "type": "boolean"
          },
          "resolver": {
            "type": "string",
            "enum": [
              "student",
              "novus"
            ]
          },
          "selfCheckText": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "id",
          "kind",
          "dimension",
          "sensitive",
          "resolver",
          "selfCheckText"
        ],
        "additionalProperties": false
      }
    },
    "nomination": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "nominator": {
              "type": "string",
              "enum": [
                "campus_rep",
                "faculty_rep",
                "department"
              ]
            },
            "campusDeadlineKinds": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "application",
                  "campus_internal",
                  "nomination",
                  "priority_round",
                  "recommendation",
                  "supplemental",
                  "interest_form",
                  "decision_expected",
                  "program_start"
                ]
              },
              "maxItems": 5
            },
            "quota": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "base": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "bonuses": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "if": {
                            "type": "string",
                            "maxLength": 80
                          },
                          "add": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "required": [
                          "if",
                          "add"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 5
                    },
                    "max": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "base",
                    "bonuses",
                    "max"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidenceKey": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^e\\d{1,3}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "nominator",
            "campusDeadlineKinds",
            "quota",
            "evidenceKey"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "ruleSet": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "hash": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "version",
            "hash"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "basedOnListedRequirements": {
      "type": "boolean"
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "sensitiveEvaluated": {
      "type": "boolean"
    }
  },
  "required": [
    "verdict",
    "status",
    "rules",
    "pending",
    "nomination",
    "ruleSet",
    "basedOnListedRequirements",
    "asOf",
    "sensitiveEvaluated"
  ],
  "additionalProperties": false
}
