{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novus/JobLeaseRequest.json",
  "title": "JobLeaseRequest",
  "type": "object",
  "properties": {
    "kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "curate_import",
          "fetch",
          "nsf_sync",
          "list_sync",
          "rollover",
          "predict_cycles",
          "llm",
          "llm_collect",
          "eval_run",
          "docintel_ocr_hint",
          "docintel_eval",
          "mirror_export",
          "backup_copy"
        ]
      },
      "minItems": 1
    },
    "max": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 5
    },
    "leaseSeconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 3600,
      "default": 600
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  },
  "required": [
    "kinds",
    "owner"
  ],
  "additionalProperties": false
}
