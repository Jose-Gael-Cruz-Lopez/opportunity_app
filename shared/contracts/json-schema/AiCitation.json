{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novus/AiCitation.json",
  "title": "AiCitation",
  "type": "object",
  "properties": {
    "sourceId": {
      "type": "string",
      "pattern": "^s\\d{1,3}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "program_page",
        "novus_record",
        "readiness_report",
        "methodology",
        "student_text"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "quote": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "sourceId",
    "kind",
    "title",
    "url",
    "quote"
  ],
  "additionalProperties": false
}
