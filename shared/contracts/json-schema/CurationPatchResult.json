{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novus/CurationPatchResult.json",
  "title": "CurationPatchResult",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "applied",
        "already_applied",
        "rejected"
      ]
    },
    "programId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "programCycleId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "release": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 60
          },
          "path": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "code",
          "path"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "status",
    "programId",
    "programCycleId",
    "release",
    "findings"
  ],
  "additionalProperties": false
}
