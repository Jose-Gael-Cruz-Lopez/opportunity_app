{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "casesFile": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "GoldenCasesFile",
      "type": "object",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "format": {
          "const": "jsonlogic-v1"
        },
        "engineMin": {
          "type": "string"
        },
        "sample": {
          "const": true
        },
        "contexts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "anchors": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "institution": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "level": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "calendar": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "academicYearStartMonth": {
                        "type": "integer"
                      },
                      "participates": {
                        "anyOf": [
                          {
                            "const": true
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "level",
                      "calendar",
                      "academicYearStartMonth",
                      "participates"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "anchors",
              "institution"
            ],
            "additionalProperties": false
          }
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "sample": {
                "const": true
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "runtimes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "node",
                    "workerd",
                    "browser",
                    "python"
                  ]
                },
                "minItems": 1
              },
              "ruleSet": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "context": {
                "type": "string"
              },
              "asOf": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "profile": {
                "type": "object",
                "additionalProperties": {}
              },
              "device": {
                "type": "object",
                "properties": {
                  "answers": {
                    "type": "object",
                    "additionalProperties": {}
                  },
                  "attestations": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "boolean"
                    }
                  }
                },
                "required": [
                  "answers",
                  "attestations"
                ],
                "additionalProperties": false
              },
              "expect": {
                "type": "object",
                "properties": {
                  "verdict": {
                    "type": "string",
                    "enum": [
                      "met",
                      "not_met",
                      "unknown"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "eligible",
                      "conditional",
                      "unknown",
                      "not_eligible"
                    ]
                  },
                  "rules": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "enum": [
                        "met",
                        "not_met",
                        "unknown"
                      ]
                    }
                  },
                  "reasonCodes": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "enum": [
                        "MET",
                        "NOT_MET",
                        "MISSING_FIELD",
                        "STRADDLES_LIMIT",
                        "PROFILE_CONFLICT",
                        "CALENDAR_CONVERSION",
                        "BORDERLINE_FIELD",
                        "PARTICIPATION_UNCONFIRMED",
                        "SENSITIVE_ON_DEVICE",
                        "SENSITIVE_UNANSWERED",
                        "CONTEXT_MISSING",
                        "RULE_ERROR",
                        "UNDETERMINED",
                        "ATTESTATION_ON_DEVICE",
                        "ATTESTATION_UNANSWERED",
                        "ATTESTATION_CONFIRMED",
                        "ATTESTATION_DECLINED",
                        "COVERAGE_NOT_REVIEWED",
                        "COVERAGE_ENCODED_EMPTY",
                        "GROUP_EMPTY",
                        "RULE_SET_MISSING"
                      ]
                    }
                  },
                  "missingFields": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "pending": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "rule",
                            "attestation",
                            "coverage",
                            "rule_set_missing"
                          ]
                        },
                        "resolver": {
                          "type": "string",
                          "enum": [
                            "student",
                            "novus"
                          ]
                        },
                        "sensitive": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "id",
                        "kind",
                        "resolver",
                        "sensitive"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "basedOnListedRequirements": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "verdict",
                  "status",
                  "rules",
                  "reasonCodes",
                  "pending",
                  "basedOnListedRequirements"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "sample",
              "tags",
              "runtimes",
              "ruleSet",
              "context",
              "asOf",
              "profile",
              "expect"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "$comment",
        "format",
        "engineMin",
        "sample",
        "contexts",
        "cases"
      ],
      "additionalProperties": false
    },
    "ruleSetsFile": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "GoldenRuleSetsFile",
      "type": "object",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "ruleSets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "sample": {
                "const": true
              },
              "note": {
                "type": "string"
              },
              "expectHash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "ruleSet": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "programCycleId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "format": {
                    "const": "jsonlogic-v1"
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "draft",
                      "verified",
                      "superseded"
                    ]
                  },
                  "templateKey": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 80
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "coverage": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "enum": [
                        "encoded",
                        "no_restriction",
                        "none_stated",
                        "not_reviewed"
                      ]
                    },
                    "propertyNames": {
                      "enum": [
                        "standing",
                        "enrollment",
                        "transfer",
                        "gpa",
                        "citizenship",
                        "pell",
                        "institution",
                        "field",
                        "identity",
                        "age",
                        "residency",
                        "first_gen",
                        "prior_award",
                        "team",
                        "host_enrollment"
                      ]
                    }
                  },
                  "rules": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}$"
                        },
                        "dimension": {
                          "type": "string",
                          "enum": [
                            "standing",
                            "enrollment",
                            "transfer",
                            "gpa",
                            "citizenship",
                            "pell",
                            "institution",
                            "field",
                            "identity",
                            "age",
                            "residency",
                            "first_gen",
                            "prior_award",
                            "team",
                            "host_enrollment"
                          ]
                        },
                        "group": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40,
                          "default": "all"
                        },
                        "logic": {
                          "type": "object",
                          "additionalProperties": {}
                        },
                        "fields": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "classYear",
                              "semestersRemaining",
                              "yearsRemaining",
                              "expectedGraduationTerm",
                              "expectedGraduationYear",
                              "enrollmentIntensity",
                              "institutionLevel",
                              "transferIntent",
                              "gpaBand",
                              "gpaMin",
                              "gpaMax",
                              "majorCip",
                              "minorCip",
                              "majorFamily",
                              "residenceState",
                              "ageAtAsOf",
                              "institutionId",
                              "institutionParticipates",
                              "citizenship",
                              "pell",
                              "financialNeed",
                              "firstGeneration",
                              "identity.race_ethnicity",
                              "identity.gender_identity",
                              "identity.sexual_orientation",
                              "identity.health",
                              "identity.religion",
                              "identity.tribal_affiliation",
                              "identity.military_veteran",
                              "identity.foster_care",
                              "identity.crime_victim",
                              "identity.parenting"
                            ]
                          },
                          "minItems": 1,
                          "maxItems": 12
                        },
                        "sensitive": {
                          "type": "boolean"
                        },
                        "asOf": {
                          "type": "string",
                          "enum": [
                            "today",
                            "campus_deadline",
                            "national_deadline",
                            "program_start"
                          ],
                          "default": "today"
                        },
                        "borderline": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "maxLength": 7
                          },
                          "maxItems": 50,
                          "default": []
                        },
                        "officialText": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 400
                        },
                        "evidenceKey": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^e\\d{1,3}$"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "default": null
                        }
                      },
                      "required": [
                        "id",
                        "dimension",
                        "logic",
                        "fields",
                        "sensitive",
                        "officialText"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 60
                  },
                  "anyOf": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120
                        }
                      },
                      "required": [
                        "id",
                        "label"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 10,
                    "default": []
                  },
                  "attestations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}$"
                        },
                        "dimension": {
                          "type": "string",
                          "enum": [
                            "standing",
                            "enrollment",
                            "transfer",
                            "gpa",
                            "citizenship",
                            "pell",
                            "institution",
                            "field",
                            "identity",
                            "age",
                            "residency",
                            "first_gen",
                            "prior_award",
                            "team",
                            "host_enrollment"
                          ]
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 400
                        },
                        "sensitive": {
                          "type": "boolean",
                          "default": true
                        },
                        "evidenceKey": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^e\\d{1,3}$"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "default": null
                        }
                      },
                      "required": [
                        "id",
                        "dimension",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 20,
                    "default": []
                  },
                  "nomination": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "nominator": {
                            "type": "string",
                            "enum": [
                              "campus_rep",
                              "faculty_rep",
                              "department"
                            ]
                          },
                          "campusDeadlineKinds": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "application",
                                "campus_internal",
                                "nomination",
                                "priority_round",
                                "recommendation",
                                "supplemental",
                                "interest_form",
                                "decision_expected",
                                "program_start"
                              ]
                            },
                            "maxItems": 5
                          },
                          "quota": {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "base": {
                                    "type": "integer",
                                    "minimum": 0
                                  },
                                  "bonuses": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "properties": {
                                        "if": {
                                          "type": "string",
                                          "maxLength": 80
                                        },
                                        "add": {
                                          "type": "integer",
                                          "minimum": 1
                                        }
                                      },
                                      "required": [
                                        "if",
                                        "add"
                                      ],
                                      "additionalProperties": false
                                    },
                                    "maxItems": 5
                                  },
                                  "max": {
                                    "type": "integer",
                                    "minimum": 0
                                  }
                                },
                                "required": [
                                  "base",
                                  "bonuses",
                                  "max"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "evidenceKey": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^e\\d{1,3}$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "nominator",
                          "campusDeadlineKinds",
                          "quota",
                          "evidenceKey"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "evidence": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "fieldEvidenceId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "basis": {
                          "type": "string",
                          "enum": [
                            "snapshot",
                            "attestation",
                            "api_record",
                            "manual_note"
                          ]
                        },
                        "url": {
                          "type": "string",
                          "format": "uri",
                          "maxLength": 2048
                        },
                        "quote": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 2000
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "retrievedOn": {
                          "anyOf": [
                            {
                              "type": "string",
                              "format": "date"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "basis",
                        "url",
                        "quote",
                        "retrievedOn"
                      ],
                      "additionalProperties": false
                    },
                    "propertyNames": {
                      "pattern": "^e\\d{1,3}$"
                    },
                    "default": {}
                  },
                  "hash": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "createdVia": {
                    "type": "string",
                    "enum": [
                      "sheet",
                      "console",
                      "rollover",
                      "llm_draft",
                      "sample"
                    ]
                  },
                  "verifiedAt": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "verifiedBy": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "fromCycleKey": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 20
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  }
                },
                "required": [
                  "id",
                  "programCycleId",
                  "version",
                  "format",
                  "state",
                  "coverage",
                  "rules",
                  "createdVia"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "sample",
              "note",
              "expectHash",
              "ruleSet"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "$comment",
        "ruleSets"
      ],
      "additionalProperties": false
    }
  }
}
